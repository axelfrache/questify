# PostgreSQL Configuration
POSTGRES_DB=questify
POSTGRES_USER=questify
POSTGRES_PASSWORD=questify_secure_password

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_password

# JWT Configuration (REQUIRED - must be at least 32 characters)
JWT_SECRET=your-256-bit-secret-here-change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# H2 Console (set to true only for local development)
H2_CONSOLE_ENABLED=false

# Rate Limiting (requests per minute)
LOGIN_RATE_LIMIT_IP=10
LOGIN_RATE_LIMIT_EMAIL=5
REGISTER_RATE_LIMIT_IP=3
REFRESH_RATE_LIMIT_IP=30