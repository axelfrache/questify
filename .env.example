# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_DB=questify
POSTGRES_USER=questify
POSTGRES_PASSWORD=questify

# ─────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────
RABBITMQ_USER=questify
RABBITMQ_PASSWORD=questify

# ─────────────────────────────────────────────
# Garage S3
# ─────────────────────────────────────────────
GARAGE_RPC_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GARAGE_ACCESS_KEY_ID=GK31c2f27ecc0e4d0c1928e5fa
GARAGE_SECRET_ACCESS_KEY=7d37e5a2f7c18b4e9d5f6a2c3b4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e

# ─────────────────────────────────────────────
# Service-specific DB users (created by init.sql)
# ─────────────────────────────────────────────
QUEST_DB_USER=quest_svc
QUEST_DB_PASSWORD=quest_svc

PROJECT_DB_USER=project_svc
PROJECT_DB_PASSWORD=project_svc

PROGRESSION_DB_USER=progression_svc
PROGRESSION_DB_PASSWORD=progression_svc

STATS_DB_USER=stats_svc
STATS_DB_PASSWORD=stats_svc

ADMIN_DB_USER=admin_svc
ADMIN_DB_PASSWORD=admin_svc

# ─────────────────────────────────────────────
# JWT (minimum 32 characters)
# ─────────────────────────────────────────────
JWT_SECRET=dev-secret-key-minimum-32-characters-long

# ─────────────────────────────────────────────
# Admin bootstrap account
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@questify.local
ADMIN_PASSWORD=Admin1234!

# ─────────────────────────────────────────────
# CORS (comma-separated)
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ─────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────
COOKIE_SECURE=false
